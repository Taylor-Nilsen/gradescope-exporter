{
  "manifest_version": 3,
  "name": "Gradescope & Canvas Exporter",
  "version": "1.1",
  "description": "Zip up your Gradescope submissions and everything in your Canvas courses.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://www.gradescope.com/*",
    "https://*.amazonaws.com/*",
    "https://*.instructure.com/*",
    "https://*.inscloudgate.net/*",
    "https://*.instructure-uploads.com/*",
    "https://*.canvas-user-content.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Export Gradescope submissions",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
